{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "1fruitsamurai-wiki",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-18",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://1fruitsamurai.wiki",
    "NEXT_PUBLIC_GA_MEASUREMENT_ID": "G-77MZ4W4FC0",
    "NEXT_PUBLIC_BING_SITE_AUTH_CODE": ""
  }
}
